<service>
  <id>SomityApi</id>
  <name>Somity API</name>
  <executable>C:\Program Files\nodejs\node.exe</executable>
  <arguments>dist/src/server.js</arguments>
  <workingdirectory>C:\Somity\app\backend</workingdirectory>
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
  </serviceaccount>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec" />
  <logpath>C:\Somity\services\api-logs</logpath>
  <log mode="roll" />
</service>
